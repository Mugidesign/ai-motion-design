{
  "name": "ai-motion-design-factory",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build",
    "dev:web": "pnpm --filter web dev",
    "dev:gateway": "pnpm --filter api-gateway dev",
    "dev:agents": "pnpm --filter agents-worker dev",
    "dev:orchestrator": "pnpm --filter orchestrator dev",
    "dev:mcp:motion": "pnpm --filter motion-generator-mcp dev",
    "dev:mcp:leads": "pnpm --filter lead-enrichment-mcp dev",
    "dev:mcp:comms": "pnpm --filter communication-mcp dev",
    "dev:mcp:knowledge": "pnpm --filter knowledge-mcp dev",
    "dev:mcp:crm": "pnpm --filter crm-finance-mcp dev",
    "deploy:all": "bash scripts/deploy-all.sh",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:up:local-llm": "docker compose -f infra/docker-compose.yml --profile local-llm up -d",
    "infra:up:admin-ui": "docker compose -f infra/docker-compose.yml --profile admin-ui up -d",
    "keys:generate": "node scripts/generate-supabase-keys.mjs",
    "db:generate": "pnpm --filter @factory/db generate",
    "db:migrate": "pnpm --filter @factory/db migrate",
    "db:studio": "pnpm --filter @factory/db studio",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
