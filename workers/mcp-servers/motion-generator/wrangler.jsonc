{
  "name": "motion-generator-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [
      { "name": "MOTION_GENERATOR_MCP", "class_name": "MotionGeneratorMcp" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MotionGeneratorMcp"] }
  ],
  "vars": {
    "MOTION_GENERATOR_DEFAULT_PROVIDER": "mock"
  }
}
