// Generated to keep 13 Durable Object bindings + migrations consistent.
// Edit freely, this is a normal wrangler.jsonc from here on.
{
  "name": "agents-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROMPT_ENGINEER_AGENT",
        "class_name": "PromptEngineerAgent"
      },
      {
        "name": "STORYBOARD_AGENT",
        "class_name": "StoryboardAgent"
      },
      {
        "name": "MOTION_DESIGNER_AGENT",
        "class_name": "MotionDesignerAgent"
      },
      {
        "name": "VIDEO_DIRECTOR_AGENT",
        "class_name": "VideoDirectorAgent"
      },
      {
        "name": "COPYWRITER_AGENT",
        "class_name": "CopywriterAgent"
      },
      {
        "name": "LEAD_FINDER_AGENT",
        "class_name": "LeadFinderAgent"
      },
      {
        "name": "SALES_AGENT",
        "class_name": "SalesAgent"
      },
      {
        "name": "CRM_AGENT",
        "class_name": "CrmAgent"
      },
      {
        "name": "FINANCE_AGENT",
        "class_name": "FinanceAgent"
      },
      {
        "name": "QA_AGENT",
        "class_name": "QaAgent"
      },
      {
        "name": "KNOWLEDGE_AGENT",
        "class_name": "KnowledgeAgent"
      },
      {
        "name": "ANALYTICS_AGENT",
        "class_name": "AnalyticsAgent"
      },
      {
        "name": "AUTOMATION_AGENT",
        "class_name": "AutomationAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PromptEngineerAgent",
        "StoryboardAgent",
        "MotionDesignerAgent",
        "VideoDirectorAgent",
        "CopywriterAgent",
        "LeadFinderAgent",
        "SalesAgent",
        "CrmAgent",
        "FinanceAgent",
        "QaAgent",
        "KnowledgeAgent",
        "AnalyticsAgent",
        "AutomationAgent"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "MOTION_GENERATOR_MCP_URL": "http://localhost:8789",
    "LEAD_ENRICHMENT_MCP_URL": "http://localhost:8790",
    "COMMUNICATION_MCP_URL": "http://localhost:8791",
    "KNOWLEDGE_MCP_URL": "http://localhost:8792",
    "CRM_FINANCE_MCP_URL": "http://localhost:8793",
    "LLM_PROVIDER": "workers-ai"
  }
  // DATABASE_URL is a secret, not a var — set it with:
  //   wrangler secret put DATABASE_URL
  // and for local dev, put it in .dev.vars (gitignored). See
  // docs/06-oss-free-stack.md and .env.example.
}
