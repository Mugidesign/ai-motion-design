{
  "name": "knowledge-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [{ "name": "KNOWLEDGE_MCP", "class_name": "KnowledgeMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KnowledgeMcp"] }],
  "ai": { "binding": "AI" }
  // DATABASE_URL is a secret pointing at the self-hosted Postgres in
  // docker-compose.yml — see docs/06-oss-free-stack.md. The AI binding
  // above doubles as the default embedding provider (bge-base-en-v1.5,
  // free/open-weight) — see src/embeddings.ts.
}
