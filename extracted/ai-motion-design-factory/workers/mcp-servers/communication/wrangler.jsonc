{
  "name": "communication-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [{ "name": "COMMUNICATION_MCP", "class_name": "CommunicationMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CommunicationMcp"] }]
  // DATABASE_URL is a secret (wrangler secret put DATABASE_URL / .dev.vars
  // locally) pointing at the self-hosted Postgres in docker-compose.yml —
  // see docs/06-oss-free-stack.md. No Hyperdrive binding: it has no free tier.
  //
  // SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM_ADDRESS
  // are secrets too (src/smtp.ts uses `cloudflare:sockets`, available by
  // default in the Workers runtime — no extra compatibility_flag needed
  // as of this writing, but confirm if `connect` throws an unexpected
  // "not supported" error on your account).
}
