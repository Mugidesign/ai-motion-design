{
  "name": "orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "services": [
    { "binding": "AGENTS_WORKER", "service": "agents-worker" }
  ],
  "triggers": {
    // Every minute: advances any pipeline_runs that are due, and drains
    // job_queue (currently just outreach sends). This Cron Trigger is
    // what replaced Cloudflare Workflows here — see
    // docs/06-oss-free-stack.md for why, and src/index.ts's `scheduled`
    // handler for the actual polling logic. Cron Triggers are available
    // on the Workers Free plan.
    "crons": ["* * * * *"]
  },
  "vars": {
    "COMMUNICATION_MCP_URL": "http://localhost:8791"
  }
  // DATABASE_URL is a secret (wrangler secret put DATABASE_URL / .dev.vars
  // locally) pointing at the self-hosted Postgres in docker-compose.yml —
  // see docs/06-oss-free-stack.md. No Hyperdrive binding: it has no free tier.
}
