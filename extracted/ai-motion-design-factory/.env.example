# ===== Self-hosted infra (infra/docker-compose.yml) =====
POSTGRES_PASSWORD=""                 # set a strong password before first `docker compose up`
GOTRUE_AUTH_ADMIN_PASSWORD=""        # password for the supabase_auth_admin Postgres role (infra/supabase/00-roles.sql)
DATABASE_URL="postgres://postgres:CHANGE_ME@localhost:5432/postgres"   # match POSTGRES_PASSWORD above

# ===== Auth — self-hosted Supabase Auth (GoTrue), NOT Supabase Cloud =====
# Generate both with: node scripts/generate-supabase-keys.mjs "$(openssl rand -base64 48)"
SUPABASE_JWT_SECRET=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""         # server-side only, never expose to the browser
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"   # the auth-proxy (nginx) container, NOT GoTrue's raw :9999
SITE_URL="http://localhost:3000"     # the Next.js app's own URL, used by GoTrue for redirects

# ===== Storage =====
R2_BUCKET_NAME="motion-factory-assets"

# ===== LLM provider (packages/agent-kit) =====
# Default is Workers AI — free tier, open-weight models, zero setup, zero API key.
LLM_PROVIDER="workers-ai"            # workers-ai|ollama|anthropic|openai
WORKERS_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"
OLLAMA_BASE_URL="http://localhost:11434"   # only used if LLM_PROVIDER=ollama; see docker-compose --profile local-llm
OLLAMA_MODEL="llama3.1"
ANTHROPIC_API_KEY=""                 # only used if LLM_PROVIDER=anthropic
OPENAI_API_KEY=""                    # only used if LLM_PROVIDER=openai, or EMBEDDING_PROVIDER=openai below

# ===== Embeddings for RAG (workers/mcp-servers/knowledge) =====
EMBEDDING_PROVIDER="workers-ai"      # workers-ai (bge-base-en-v1.5, free, 768-dim) | openai (1536-dim, needs a schema change)

# ===== Motion Generator providers =====
# "mock" always works (placeholder output, $0). "oss-selfhosted" is the
# recommended real, $0-in-software-cost option — see infra/oss-video-server/.
# Commercial APIs remain available as opt-ins.
MOTION_GENERATOR_DEFAULT_PROVIDER="mock"   # mock|oss-selfhosted|runway|kling|luma|pika|veo|higgsfield|openai
OSS_VIDEO_ENDPOINT_URL=""            # your Wan2.1/HunyuanVideo server, e.g. a Lightning AI Studio's exposed port
OSS_VIDEO_API_KEY=""                 # optional shared secret for the above
RUNWAY_API_KEY=""
KLING_API_KEY=""
LUMA_API_KEY=""
PIKA_API_KEY=""
VEO_API_KEY=""
HIGGSFIELD_API_KEY=""

# ===== Lead enrichment (compliant sources only — see docs/05) =====
GOOGLE_PLACES_API_KEY=""
CRUNCHBASE_API_KEY=""
PRODUCT_HUNT_API_TOKEN=""
YOUTUBE_DATA_API_KEY=""

# ===== Outreach sending — self-hosted/BYO SMTP (workers/mcp-servers/communication/src/smtp.ts) =====
SMTP_HOST=""                         # your own Postfix, or any SMTP relay's free tier
SMTP_PORT="465"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_ADDRESS="AI Motion Design Factory <outreach@yourdomain.example>"
GMAIL_OAUTH_CLIENT_ID=""             # for tenant-connected mailboxes (low-volume follow-ups only) — not implemented in this scaffold
GMAIL_OAUTH_CLIENT_SECRET=""
SLACK_WEBHOOK_URL=""

# ===== Billing =====
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ===== Service URLs (wire these up after first `wrangler deploy`, or use service bindings) =====
NEXT_PUBLIC_API_GATEWAY_URL="http://localhost:8787"
NEXT_PUBLIC_AGENTS_WORKER_URL="http://localhost:8788"
MOTION_GENERATOR_MCP_URL="http://localhost:8789"
LEAD_ENRICHMENT_MCP_URL="http://localhost:8790"
COMMUNICATION_MCP_URL="http://localhost:8791"
KNOWLEDGE_MCP_URL="http://localhost:8792"
CRM_FINANCE_MCP_URL="http://localhost:8793"
