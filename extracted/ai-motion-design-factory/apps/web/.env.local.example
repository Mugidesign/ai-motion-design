# apps/web/.env.local.example
#
# Next.js reads .env files from THIS directory (apps/web/), not the
# monorepo root — the root .env.example documents every service's
# variables in one place for reference, but each Worker/app still needs
# its own copy in the location its runtime actually reads from:
#   - Workers: `wrangler secret put` + `.dev.vars` inside each
#     workers/*/ package
#   - This Next.js app: `apps/web/.env.local` (this file, copied and filled in)
#
# Copy this to apps/web/.env.local and fill in real values. Only
# NEXT_PUBLIC_* variables are usable here — Next.js inlines them into the
# client bundle at build time, so nothing secret belongs in this file.

# Self-hosted Supabase Auth (GoTrue), via the nginx auth-proxy — see
# infra/docker-compose.yml and docs/06-oss-free-stack.md. NOT a Supabase
# Cloud project URL.
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Cloudflare Workers, once running (wrangler dev locally, or their
# deployed URLs in production).
NEXT_PUBLIC_API_GATEWAY_URL="http://localhost:8787"
NEXT_PUBLIC_AGENTS_WORKER_URL="http://localhost:8788"
